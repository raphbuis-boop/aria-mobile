# Copy to apps/web/.env.local and apps/mobile/.env
# Never commit real values. Service role and API secrets stay server-side only.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_AGENT_ID=
LEAD_WEBHOOK_SECRET=
TRANSCRIPT_WEBHOOK_SECRET=
TWILIO_WEBHOOK_SECRET=
CRON_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Mobile (Expo) — same public keys, prefixed EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_URL=http://localhost:3000

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Embeddings (Claude has no embedding API; OpenAI is the default vector encoder) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_VOICE_WEBHOOK_URL=

# --- RESO / MLS ---
RESO_WEB_API_BASE_URL=
RESO_CLIENT_ID=
RESO_CLIENT_SECRET=
RESO_TOKEN_URL=
RESO_BEARER_TOKEN=
RESO_USER_AGENT=AriaAI/0.1

# --- DocuSign ---
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_PATH=account-d.docusign.com
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_RSA_PRIVATE_KEY=
DOCUSIGN_TEMPLATE_PURCHASE_ID=

# --- Lead portals ---
META_APP_SECRET=
META_VERIFY_TOKEN=
ZILLOW_WEBHOOK_SECRET=
REALTOR_WEBHOOK_SECRET=

# --- Optional n8n ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
